# ---- Runtime ----
NODE_ENV=development

# Public app origin. Used for absolute URLs and for Auth.js host validation.
NEXT_PUBLIC_APP_NAME=OpsFlow
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# ---- Database ----
# Local Postgres from docker-compose.yml
DATABASE_URL="postgresql://opsflow:opsflow_dev_password@localhost:5432/opsflow?schema=public"

# ---- Authentication ----
# REQUIRED. Generate with:  openssl rand -base64 32
# Must be at least 32 characters. Never commit a real value.
AUTH_SECRET="replace-me-with-a-32-character-minimum-random-secret"

# Validate the incoming Host header against this value. Keep it `true` when the
# app runs behind a reverse proxy or on localhost (the default). Set to `false`
# only if OpsFlow is exposed directly on a host you control.
AUTH_TRUST_HOST=true

# ---- Observability ----
# debug | info | warn | error | silent
LOG_LEVEL=info

# ---- Rate limiting ----
# Per-process fixed-window limits (see README "Known limitations").
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_ATTEMPTS=10
RATE_LIMIT_WINDOW_MS=60000

# ---- Redis (reserved; not consumed yet) ----
# Infrastructure-ready for Phase 2 background jobs. Nothing reads this in
# Phase 1, so it is safe to leave unset.
# REDIS_URL="redis://localhost:6379"
