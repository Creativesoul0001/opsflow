// OpsFlow schema — Phase 1 foundation, Phase 2 CRM (Customers), Phase 3 Orders,
// Phase 4 Inventory.
//
// Design notes:
//  * Every tenant-owned row hangs off `Organization` through
//    `OrganizationMembership`. Business tables (Customers, Orders, Inventory,
//    Support, Finance, ...) must carry `organizationId` and MUST never be
//    queried without a verified membership scope.
//  * `Role` and `Permission` are global reference data, seeded by
//    `prisma/seed.ts`. They are not tenant-owned so that role definitions stay
//    consistent across every organization.
//  * IDs use UUIDv7: globally unique without coordination, and time-ordered so
//    index locality stays good as the tables grow.
//  * Money is stored as integer minor units (paise/cents) exactly as Orders does;
//    a float is never used for an amount. Stock quantities are integers because
//    every supported product is counted in whole units (see `Product.unit`).
//    Fractional weights would need a Decimal column and would make the
//    `quantityBefore`/`quantityAfter` audit trail ambiguous while rounding.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  LEAD
  ARCHIVED
}

enum CustomerType {
  INDIVIDUAL
  BUSINESS
}

/// Phase 2 CRM audit trail. Activities are written as a side effect of real
/// operations rather than posted directly, so the timeline cannot be forged.
enum CustomerActivityType {
  CREATED
  UPDATED
  NOTE_ADDED
  ASSIGNED
  ARCHIVED
}

/// Order lifecycle states.
///
/// `CANCELLED` and `DELIVERED` are terminal. Legal transitions are enforced in
/// `src/lib/orders/status.ts`, not in the database, so the API can return a
/// meaningful validation error.
enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

/// Types of activities recorded on an order timeline.
enum OrderActivityType {
  CREATED
  UPDATED
  STATUS_CHANGED
  ASSIGNED
  CANCELLED
  NOTE_ADDED
}

/// Inventory: a product is either sellable or archived. There is no hard delete
/// path, so stock movements and order history can always explain what happened.
enum ProductStatus {
  ACTIVE
  ARCHIVED
}

enum WarehouseStatus {
  ACTIVE
  ARCHIVED
}

/// Why a `StockMovement` row exists. The enum is part of the audit trail: a
/// movement created by the order workflow (`ORDER_DEDUCTION` / `ORDER_RELEASE`)
/// is distinguishable from one a member made by hand (`RECEIPT` /
/// `ADJUSTMENT`) and from one produced by a transfer (`TRANSFER_OUT` /
/// `TRANSFER_IN`).
enum StockMovementType {
  /// Opening balance or a delivery from a supplier.
  RECEIPT
  /// Manual correction after a stock count.
  ADJUSTMENT
  /// Stock left the source warehouse of a transfer.
  TRANSFER_OUT
  /// Stock arrived in the destination warehouse of a transfer.
  TRANSFER_IN
  /// Stock left a warehouse because an order was confirmed.
  ORDER_DEDUCTION
  /// Stock returned to a warehouse because a confirmed order was cancelled.
  ORDER_RELEASE
}

enum StockTransferStatus {
  COMPLETED
  CANCELLED
}

model User {
  id           String     @id @default(uuid(7)) @db.Uuid
  email        String     @unique
  name         String
  passwordHash String     @map("password_hash")
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?  @map("last_login_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  memberships        OrganizationMembership[]
  assignedCustomers  Customer[]               @relation("CustomerAssignee")
  assignedOrders     Order[]                  @relation("OrderAssignee")
  customerActivities CustomerActivity[]
  orderActivities    OrderActivity[]
  stockMovements     StockMovement[]
  stockTransfers     StockTransfer[]

  @@index([status])
  @@map("users")
}

model Organization {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships           OrganizationMembership[]
  customers             Customer[]
  customerActivities    CustomerActivity[]
  orders                Order[]
  orderItems            OrderItem[]
  orderActivities       OrderActivity[]
  orderSequence         OrderSequence?
  productCategories     ProductCategory[]
  products              Product[]
  warehouses            Warehouse[]
  inventoryStocks       InventoryStock[]
  stockMovements        StockMovement[]
  stockTransfers        StockTransfer[]
  stockTransferSequence StockTransferSequence?

  @@map("organizations")
}

model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  key         String   @unique
  name        String
  description String
  /// System roles are seeded and cannot be repurposed or deleted by tenants.
  isSystem    Boolean  @default(true) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  permissions RolePermission[]
  memberships OrganizationMembership[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// Canonical `resource:action` key, e.g. `orders:write`.
  key         String   @unique
  resource    String
  action      String
  description String
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model OrganizationMembership {
  id             String           @id @default(uuid(7)) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  roleId         String           @map("role_id") @db.Uuid
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  /// A user holds at most one role per organization.
  @@unique([userId, organizationId])
  @@index([organizationId, status])
  @@index([roleId])
  @@map("organization_memberships")
}

/// A CRM customer record. Always owned by exactly one organization.
///
/// Archiving is the removal mechanism: `archivedAt` is set and `status` becomes
/// `ARCHIVED`, so history and the activity trail survive. There is no hard
/// delete path in the API.
model Customer {
  id             String         @id @default(uuid(7)) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  firstName      String         @map("first_name")
  lastName       String         @map("last_name")
  email          String
  phone          String?
  companyName    String?        @map("company_name")
  status         CustomerStatus @default(ACTIVE)
  customerType   CustomerType   @default(INDIVIDUAL) @map("customer_type")
  /// Assignee. Null means unassigned. Must be an ACTIVE member of the same
  /// organization - `users` is global, so the service layer verifies this.
  assignedUserId String?        @map("assigned_user_id") @db.Uuid
  notes          String?
  archivedAt     DateTime?      @map("archived_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedUser User?              @relation("CustomerAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  activities   CustomerActivity[]
  orders       Order[]

  /// One record per email address per organization. Emails are deliberately not
  /// globally unique: the same person can legitimately be a customer of two
  /// different organizations.
  @@unique([organizationId, email])
  @@index([organizationId, archivedAt])
  @@index([organizationId, status])
  @@index([organizationId, customerType])
  @@index([organizationId, assignedUserId])
  @@index([organizationId, createdAt])
  @@index([organizationId, lastName, firstName])
  @@map("customers")
}

/// Append-only audit trail powering the customer timeline.
///
/// `userId` is nullable with `onDelete: SetNull` so history survives the removal
/// of the member who performed the action.
model CustomerActivity {
  id             String               @id @default(uuid(7)) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  customerId     String               @map("customer_id") @db.Uuid
  userId         String?              @map("user_id") @db.Uuid
  type           CustomerActivityType
  description    String
  createdAt      DateTime             @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Serves the timeline query, which is always tenant- and customer-scoped.
  @@index([customerId, createdAt])
  @@index([organizationId, createdAt])
  @@map("customer_activities")
}

/// A business order. Every order belongs to exactly one organization and one
/// customer. Financial totals are computed server-side and stored as integers
/// to avoid floating-point errors for currency values.
///
/// `subtotal`, `discount`, `tax`, `total` and `OrderItem` amounts are all stored
/// in the organization's minor currency unit (e.g. paise) as PostgreSQL `int4`.
/// The service layer rejects anything that would overflow that range.
model Order {
  id             String      @id @default(uuid(7)) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  customerId     String      @map("customer_id") @db.Uuid
  /// Human-readable order number unique within the organization (e.g. ORD-000001).
  /// Always allocated from `OrderSequence`; never accepted from a client.
  orderNumber    String      @map("order_number")
  status         OrderStatus @default(PENDING)
  /// Sum of line-item totals before order-level discount and tax.
  subtotal       Int         @default(0)
  /// Order-level discount in minor units. Never exceeds `subtotal - tax`.
  discount       Int         @default(0)
  /// Tax in minor units. Always computed from `taxRate` and the discounted
  /// subtotal by the server; never accepted from a client.
  tax            Int         @default(0)
  /// Tax rate snapshot, in basis points (1800 = 18.00%). Kept so the order can
  /// still explain its own total after the configured rate changes.
  taxRate        Int         @default(0) @map("tax_rate")
  /// `subtotal - discount + tax`. Recomputed server-side on every mutation.
  total          Int         @default(0)
  notes          String?
  /// Assignee. Null means unassigned. Must be an ACTIVE member of the same
  /// organization - `users` is global, so the service layer verifies this.
  assignedUserId String?     @map("assigned_user_id") @db.Uuid
  /// Set when the order moves to `CANCELLED`. Cancellation is a status change,
  /// never a hard delete, so order history survives.
  cancelledAt    DateTime?   @map("cancelled_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  assignedUser User?           @relation("OrderAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  items        OrderItem[]
  activities   OrderActivity[]
  movements    StockMovement[]

  @@unique([organizationId, orderNumber])
  @@index([organizationId, status])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, customerId])
  @@index([organizationId, customerId, createdAt])
  @@index([organizationId, assignedUserId])
  @@index([organizationId, createdAt])
  @@map("orders")
}

/// Order line item.
///
/// `organizationId` mirrors the parent order's organization so that every
/// tenant-owned row can be filtered without a join. The service layer asserts it
/// equals the parent order's organization on write.
///
/// `productId` addresses a `Product` when the line refers to a stocked catalogue
/// item. It is nullable (an order may price an ad-hoc service) and archived —
/// never deleted — which is what lets the reference stay sound: the product name
/// is snapshotted onto the line, so history still reads correctly after the
/// catalogue entry is renamed.
model OrderItem {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  productId      String?  @map("product_id") @db.Uuid
  /// Name captured at the time the order was placed. Order history must keep
  /// showing what was ordered even if the product is later renamed.
  productName    String   @map("product_name")
  quantity       Int
  /// Price per unit in minor currency units.
  unitPrice      Int      @map("unit_price")
  /// Line discount in minor currency units. Never exceeds `quantity * unitPrice`.
  discount       Int      @default(0)
  /// `quantity * unitPrice - discount`. Recomputed server-side on every write.
  total          Int      @default(0)
  /// Zero-based index of the line within its order, assigned server-side.
  ///
  /// `created_at` cannot order line items: every row in one insert shares the
  /// transaction timestamp, so lines would otherwise render in an arbitrary
  /// order that changes between reads.
  position       Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product?     @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([organizationId, orderId])
  @@index([orderId, position])
  @@index([organizationId, productId])
  @@map("order_items")
}

/// Per-organization order-number counter.
///
/// Order numbers are human-readable and sortable (`ORD-000001`), which rules out
/// a sequence per tenant. A single row per organization is incremented inside
/// the same transaction that creates the order, so concurrent creates can never
/// receive the same number.
model OrderSequence {
  organizationId String   @id @map("organization_id") @db.Uuid
  /// Highest number issued so far.
  lastNumber     Int      @default(0) @map("last_number")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("order_sequences")
}

/// Append-only timeline of order events.
///
/// Mirrors `CustomerActivity`: written as a side effect of real operations by
/// the service layer so the timeline cannot be forged directly, and `userId`
/// uses `onDelete: SetNull` so history survives member removal.
model OrderActivity {
  id             String            @id @default(uuid(7)) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  orderId        String            @map("order_id") @db.Uuid
  userId         String?           @map("user_id") @db.Uuid
  type           OrderActivityType
  description    String
  createdAt      DateTime          @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, orderId, createdAt])
  @@index([orderId, createdAt])
  @@map("order_activities")
}

// ---------------------------------------------------------------------------
// Phase 4 — Inventory
// ---------------------------------------------------------------------------
//
// The inventory domain is an append-only ledger of stock movements plus the
// per-warehouse balances the ledger explains. Every quantity that ever changes
// writes a `StockMovement` row in the same transaction, so a balance can always
// be traced back to the movements that produced it.
//
// Three rules hold throughout:
//
//  1. Nothing deletes. Products, categories and warehouses are archived. A
//     product that was once on an order must remain addressable forever, because
//     order history and stock movements both point at it.
//  2. Balances are locked before they are changed. The stock service takes row
//     locks (`SELECT ... FOR UPDATE`) inside a transaction, so two simultaneous
//     adjustments or transfers cannot read the same starting quantity and lose
//     one of the two writes.
//  3. Order effects are idempotent. `StockMovement` carries the two partial
//     unique indexes below; combined with the one-way order workflow they make
//     "charge twice" and "refund twice" impossible even if a request is retried.

/// A product grouping, e.g. "Beverages". Archiving detaches the product list's
/// filter but never removes the grouping from existing products.
model ProductCategory {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  description    String?
  archivedAt     DateTime? @map("archived_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     Product[]

  /// Category names are unique per organization. Two organizations may both have
  /// a "Beverages" category without any conflict.
  @@unique([organizationId, name])
  @@index([organizationId, archivedAt])
  @@map("product_categories")
}

/// A sellable catalogue item, scoped to one organization.
///
/// `sku` is unique per organization and is the natural key a member types; the
/// `Product.id` UUID is never shown. `unitPrice` is what a customer is charged
/// (the same minor-unit currency Orders uses) and `costPrice` is what the
/// organization paid — it is optional because a reseller may not want to store
/// supplier pricing at all.
model Product {
  id               String        @id @default(uuid(7)) @db.Uuid
  organizationId   String        @map("organization_id") @db.Uuid
  /// Null means "uncategorised", which is why the relation is `SetNull`.
  categoryId       String?       @map("category_id") @db.Uuid
  sku              String
  name             String
  description      String?
  /// Selling price in minor currency units. Always server-derived from the input.
  unitPrice        Int           @default(0) @map("unit_price")
  /// Purchase cost in minor currency units, when tracked.
  costPrice        Int?          @map("cost_price")
  /// Quantity at or below which the product is reported as low stock. Zero means
  /// "no reorder point configured" and therefore never flags.
  reorderThreshold Int           @default(0) @map("reorder_threshold")
  /// The unit this product is counted in, e.g. "pcs", "kg", "box". Stock
  /// quantities are whole numbers of it.
  unit             String        @default("pcs")
  status           ProductStatus @default(ACTIVE)
  archivedAt       DateTime?     @map("archived_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  stocks       InventoryStock[]
  movements    StockMovement[]
  orderItems   OrderItem[]

  @@unique([organizationId, sku])
  @@index([organizationId, status])
  @@index([organizationId, categoryId])
  @@index([organizationId, name])
  @@index([organizationId, createdAt])
  @@map("products")
}

/// A physical location that holds stock.
model Warehouse {
  id             String          @id @default(uuid(7)) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  /// Short human-entered code, e.g. "WH-1" or "MUM". Unique per organization.
  code           String
  name           String
  addressLine1   String?         @map("address_line1")
  addressLine2   String?         @map("address_line2")
  city           String?
  state          String?
  postalCode     String?         @map("postal_code")
  country        String?
  /// True for exactly one ACTIVE warehouse per organization (enforced by the
  /// service): the default source for order deductions.
  isPrimary      Boolean         @default(false) @map("is_primary")
  status         WarehouseStatus @default(ACTIVE)
  archivedAt     DateTime?       @map("archived_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stocks       InventoryStock[]
  movements    StockMovement[]
  transfersOut StockTransfer[]  @relation("TransferFrom")
  transfersIn  StockTransfer[]  @relation("TransferTo")

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, isPrimary])
  @@map("warehouses")
}

/// Current on-hand quantity of one product in one warehouse.
///
/// The row is the aggregate of the movements; the service always updates the row
/// and writes the movement in the same transaction so the two cannot disagree.
/// `quantity` is signed: zero and positive mean stock on hand, and the service
/// refuses to make it negative.
model InventoryStock {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  warehouseId    String   @map("warehouse_id") @db.Uuid
  quantity       Int      @default(0)
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  /// One balance per product per warehouse. This constraint is what makes
  /// `upsert` safe under concurrency: a race resolves into a single row.
  @@unique([productId, warehouseId])
  @@index([organizationId, productId])
  @@index([organizationId, warehouseId])
  @@index([productId, quantity])
  @@map("inventory_stocks")
}

/// A stock transfer between two warehouses of the same organization.
///
/// A transfer is recorded once and completed atomically: the pair of movements
/// it produces (`TRANSFER_OUT` at the source, `TRANSFER_IN` at the destination)
/// commit together, so a transfer can never leave quantity in limbo. The
/// `CANCELLED` status exists for a transfer that was rejected before any
/// movement was written.
model StockTransfer {
  id              String              @id @default(uuid(7)) @db.Uuid
  organizationId  String              @map("organization_id") @db.Uuid
  /// Human-readable transfer number unique within the organization.
  number          String
  fromWarehouseId String              @map("from_warehouse_id") @db.Uuid
  toWarehouseId   String              @map("to_warehouse_id") @db.Uuid
  status          StockTransferStatus @default(COMPLETED)
  notes           String?
  /// The member who performed it. Nullable so history survives their removal.
  userId          String?             @map("user_id") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  organization  Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fromWarehouse Warehouse       @relation("TransferFrom", fields: [fromWarehouseId], references: [id], onDelete: Restrict)
  toWarehouse   Warehouse       @relation("TransferTo", fields: [toWarehouseId], references: [id], onDelete: Restrict)
  user          User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  movements     StockMovement[]

  @@unique([organizationId, number])
  @@index([organizationId, createdAt])
  @@index([organizationId, fromWarehouseId])
  @@index([organizationId, toWarehouseId])
  @@map("stock_transfers")
}

/// Per-organization transfer-number counter, mirroring `OrderSequence`.
model StockTransferSequence {
  organizationId String   @id @map("organization_id") @db.Uuid
  lastNumber     Int      @default(0) @map("last_number")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("stock_transfer_sequences")
}

/// Append-only stock ledger.
///
/// `quantity` is the signed change that was applied; `quantityBefore` and
/// `quantityAfter` are the balance of `(productId, warehouseId)` either side of
/// it. Together they form an audit trail that can be replayed: the first
/// movement's `quantityBefore` plus every subsequent `quantity` must reproduce
/// the current `InventoryStock`.
///
/// The two partial unique constraints are the idempotency guards for order
/// integration and transfers. A `NULL` in the leading column never conflicts
/// with another `NULL` (Postgres treats NULLs as distinct), so ordinary receipts
/// and manual adjustments are unlimited, while the order-driven rows — which
/// must be written at most once each — cannot be duplicated.
model StockMovement {
  id             String            @id @default(uuid(7)) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  productId      String            @map("product_id") @db.Uuid
  warehouseId    String            @map("warehouse_id") @db.Uuid
  type           StockMovementType
  /// Signed change applied to the warehouse balance.
  quantity       Int
  quantityBefore Int               @map("quantity_before")
  quantityAfter  Int               @map("quantity_after")
  reason         String?
  /// The order this movement belongs to, for `ORDER_*` types.
  orderId        String?           @map("order_id") @db.Uuid
  /// The transfer this movement belongs to, for `TRANSFER_*` types.
  transferId     String?           @map("transfer_id") @db.Uuid
  /// The member who performed it. Nullable so history survives their removal.
  userId         String?           @map("user_id") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse    Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  order        Order?         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  transfer     StockTransfer? @relation(fields: [transferId], references: [id], onDelete: Cascade)
  user         User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// At most one ORDER_DEDUCTION and one ORDER_RELEASE per product per
  /// warehouse per order — the guard that makes charging an order twice
  /// impossible.
  @@unique([orderId, productId, warehouseId, type])
  /// At most one TRANSFER_OUT and one TRANSFER_IN per product per warehouse per
  /// transfer.
  @@unique([transferId, productId, warehouseId, type])
  @@index([organizationId, productId, createdAt])
  @@index([organizationId, warehouseId, createdAt])
  @@index([organizationId, createdAt])
  @@index([orderId])
  @@index([transferId])
  @@map("stock_movements")
}
